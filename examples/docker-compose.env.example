# --- paperless-mineru: append to your docker-compose.env ---------------------
# Required: base URL of your MinerU API server (no trailing path).
PAPERLESS_MINERU_ENDPOINT=http://mineru.example.lan:8000

# Optional: only if your MinerU server enforces an API key (MinerU >= 4 --api-key).
# Put it here or in a secret-managed env file, never in git.
#PAPERLESS_MINERU_API_KEY=

# API flavour: auto (default) | legacy (MinerU 2.x/3.x) | v1 (MinerU >= 4.0)
#PAPERLESS_MINERU_API=auto

# MinerU 2.x/3.x options (unset = server default)
#PAPERLESS_MINERU_BACKEND=hybrid-engine
#PAPERLESS_MINERU_EFFORT=medium
#PAPERLESS_MINERU_LANG=ch          # pipeline OCR language; derived from PAPERLESS_OCR_LANGUAGE
#PAPERLESS_MINERU_FORMULA_ENABLE=true
#PAPERLESS_MINERU_TABLE_ENABLE=true

# MinerU >= 4.0 option
#PAPERLESS_MINERU_TIER=standard     # flash | basic | standard | advanced

# Shared
#PAPERLESS_MINERU_OCR_MODE=auto     # auto | txt | ocr
#PAPERLESS_MINERU_TIMEOUT=900       # seconds per document (submit + queue + parse)
#PAPERLESS_MINERU_CONNECT_TIMEOUT=10
#PAPERLESS_MINERU_POLL_INTERVAL=2
#PAPERLESS_MINERU_CONTENT_FORMAT=markdown   # markdown | text
#PAPERLESS_MINERU_TEXT_LAYER=true   # write invisible text layer into the archive PDF
#PAPERLESS_MINERU_PDFA=true         # PDF/A conversion per PAPERLESS_OCR_OUTPUT_TYPE (no Tesseract)
#PAPERLESS_MINERU_SCORE=20          # > 10 beats the built-in Tesseract parser
#PAPERLESS_MINERU_VERIFY_SSL=true

# Paperless core: send everything to remote parsers (default) or only via workflow
#PAPERLESS_REMOTE_OCR_MODE=always   # always | workflow_only
